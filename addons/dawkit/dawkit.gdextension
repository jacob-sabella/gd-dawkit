[configuration]

entry_symbol = "dawkit_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://addons/dawkit/bin/libdawkit.linux.template_debug.so"
linux.release.x86_64 = "res://addons/dawkit/bin/libdawkit.linux.template_release.so"
windows.debug.x86_64 = "res://addons/dawkit/bin/libdawkit.windows.template_debug.dll"
windows.release.x86_64 = "res://addons/dawkit/bin/libdawkit.windows.template_release.dll"
